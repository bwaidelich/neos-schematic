{
    "name": "neos/schematic",
    "description": "The bridge between PHP classes and JSON Schema: a type owns its schema by returning it from a static schema(), and Schematic validates input against it, builds the instance, and reads it back out.",
    "type": "library",
    "support": {
        "source": "https://github.com/neos/schematic.git",
        "forum": "https://discuss.neos.io/",
        "docs": "https://docs.neos.io/"
    },
    "require": {
        "php": ">=8.4",
        "neos/jsonschema": "dev-main"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^10 || ^11 || ^12"
    },
    "repositories": [
        {
            "type": "vcs",
            "url":  "https://github.com/bwaidelich/neos-jsonschema"
        }
    ],
    "autoload": {
        "psr-4": {
            "Neos\\Schematic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neos\\Schematic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:phpstan": "phpstan",
        "test:cs": "php-cs-fixer check",
        "test:cs:fix": "php-cs-fixer fix",
        "test:phpunit": "phpunit",
        "test": [
            "@test:phpstan",
            "@test:cs",
            "@test:phpunit"
        ]
    }
}
